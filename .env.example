# ============================================================
# AI Defect Analysis System — Environment Configuration
# ============================================================

# Application
APP_NAME=AI Defect Analysis System
APP_VERSION=1.0.0-M1
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/defect_analysis
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=defect_analysis
POSTGRES_PORT=5432

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_HOST=localhost
CHROMA_PORT=8001

# LLM Configuration (OpenAI-compatible)
# Leave OPENAI_API_KEY empty for mock mode
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MODE=mock
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2000

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# Search
DEFAULT_TOP_K=5
SIMILARITY_THRESHOLD=0.7

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
